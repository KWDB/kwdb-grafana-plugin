          "rawSql": "SELECT time_bucket(\"ts\", '1m') AS \"time\", avg(\"temperature\") AS \"avg_temperature\" FROM \"sensors\" WHERE \"ts\" >= $__timeFrom AND \"ts\" <= $__timeTo GROUP BY \"time\" ORDER BY \"time\"",
